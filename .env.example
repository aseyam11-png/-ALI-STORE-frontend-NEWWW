# Frontend API endpoint.
# Recommended: leave empty so the browser uses the same-origin /api/v1 bridge.
NEXT_PUBLIC_API_BASE_URL=

# Server-side/private backend origin used by Next.js rewrites and SSR.
# Local development:
BACKEND_INTERNAL_URL=http://localhost:8080
#
# Production: set BACKEND_INTERNAL_URL to the deployed Spring Boot base URL.
# Never use localhost in Vercel production. BACKEND_INTERNAL_URL or
# NEXT_PUBLIC_API_BASE_URL must be configured before authenticated/runtime requests.

# Optional media backend origin used by Next/Image for product assets.
NEXT_PUBLIC_MEDIA_BASE_URL=

# Optional production observability
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Keep SENTRY_AUTH_TOKEN only in GitHub/Vercel secrets; never commit the value.

# UX / CRO analytics
NEXT_PUBLIC_UX_ANALYTICS_ENABLED=false
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
