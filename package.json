{
  "name": "enterprise-commerce-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "npm run test:contracts && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "test:contracts": "node --test \"tests/**/*.test.mjs\"",
    "test": "npm run test:contracts",
    "verify": "npm run lint && npm run typecheck && npm run build",
    "verify:ci": "npm run verify",
    "test:unit": "npx vitest run",
    "test:e2e:playwright": "npx playwright test",
    "test:e2e:cypress": "npx cypress run",
    "test:a11y": "npx pa11y-ci http://127.0.0.1:3000/",
    "quality:lighthouse": "npx lhci autorun --config=.lighthouserc.cjs",
    "quality:visual": "npx backstop test",
    "quality:advanced": "npm run lint && npm run typecheck && npm run test:unit && npm run build",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.90.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^0.542.0",
    "next": "16.4.1",
    "next-intl": "^4.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "sharp": "0.35.5",
    "tailwind-merge": "^3.3.1",
    "zod": "4.6.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.3.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.35.0",
    "eslint-config-next": "16.4.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
