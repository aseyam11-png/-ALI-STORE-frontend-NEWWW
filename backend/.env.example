# Authentication / JWT
JWT_SECRET=<base64-encoded-strong-secret>
JWT_EXPIRATION=86400000
JWT_ISSUER=ali-store-backend

# Encrypted authentication session cookie
AUTH_COOKIE_NAME=ali_store_session
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=None
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_ENCRYPTION_KEY=<base64-encoded-32-byte-or-longer-secret>

# Email OTP hashing (must be a different secret from JWT_SECRET and AUTH_COOKIE_ENCRYPTION_KEY)
AUTH_OTP_HASH_SECRET=<base64-encoded-32-byte-or-longer-secret>
AUTH_EMAIL_VERIFICATION_ENABLED=true
AUTH_LOGIN_EMAIL_OTP_ENABLED=true
AUTH_EMAIL_CODE_EXPIRATION_SECONDS=600
AUTH_EMAIL_CODE_MAX_ATTEMPTS=5
AUTH_EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60

# SMTP
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=<smtp-username>
MAIL_PASSWORD=<smtp-password>
MAIL_FROM=no-reply@example.com
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# Google OAuth
GOOGLE_CLIENT_ID=<google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<google-oauth-client-secret>
FRONTEND_AUTH_SUCCESS_REDIRECT=https://your-store.example/buyer/profile
FRONTEND_AUTH_FAILURE_REDIRECT=https://your-store.example/login?error=google

# CORS
CORS_ALLOWED_ORIGINS=https://your-store.example
